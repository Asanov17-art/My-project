# Credentials from https://openservice.aliexpress.com (AliExpress Open Platform).
# Register an app, subscribe to the "Affiliate" API package, then copy the keys here.
ALIEXPRESS_APP_KEY=your_app_key
ALIEXPRESS_APP_SECRET=your_app_secret

# Your affiliate tracking id (created in the AliExpress Portals / affiliate console).
ALIEXPRESS_TRACKING_ID=your_tracking_id

# Optional overrides.
# ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync
# ALIEXPRESS_SIGN_METHOD=sha256
